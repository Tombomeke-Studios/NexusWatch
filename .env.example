# NexusWatch collector — copy to .env (repo root). `npm run dev` / `npm run dev:collector` and
# docker compose read it. Every source is off until its variable is set; whatever has no source
# is served from the dashboard's sample data, so the API is always complete.

# ── HTTP + storage ─────────────────────────────────────────────────────
NW_PORT=8080
# SQLite file (relative to collector/). In Docker: /data/nexuswatch.db on a volume.
NW_DB_PATH=data/nexuswatch.db
# Shown on the sidebar host card. In Docker the collector sees only its own container, so set the
# address; the name defaults to the Docker host's name when the socket below is mounted.
#NW_HOST_NAME=home-server
#NW_HOST_ADDRESS=192.168.1.20

# ── Heartbeat checker: GET every /health ───────────────────────────────
# JSON array, or point NW_HEALTH_TARGETS_FILE at a file (see collector/targets.example.json).
# Fields: id, name, project (nexusinfra|finvault), url; optional port, intervalMs, timeoutMs.
#NW_HEALTH_TARGETS=[{"id":"nx-control-room","name":"control-room","project":"nexusinfra","url":"http://localhost:9000/health"}]
#NW_HEALTH_TARGETS_FILE=targets.json
NW_HEALTH_INTERVAL_MS=30000
NW_HEALTH_TIMEOUT_MS=5000
# An answer slower than this is "slow"
NW_HEALTH_SLOW_MS=100
# Consecutive failed checks before an incident (and an active alert) opens
NW_HEALTH_FAILURES_FOR_INCIDENT=3

# ── NexusInfra Control Room: GET /status + /uptime ─────────────────────
#NW_CONTROL_ROOM_URL=http://localhost:9000
NW_CONTROL_ROOM_INTERVAL_MS=10000
# Sources whose name matches are nodes (NexusInfra's default node id is node-<hostname>)
NW_NODE_PATTERN=^node-

# ── Prometheus scrape of NexusInfra /metrics ───────────────────────────
# name=url pairs, comma-separated
#NW_METRICS_TARGETS=control-room=http://localhost:9000/metrics,orchestrator=http://localhost:9200/metrics,gateway=http://localhost:9400/metrics,node-agent=http://localhost:9100/metrics,billing-bridge=http://localhost:9300/metrics
NW_METRICS_INTERVAL_MS=15000
# NexusInfra's METRICS_TOKEN, when its /metrics is protected
#NW_METRICS_TOKEN=

# ── Event bus: monitoring.heartbeat.# on the finvault.events exchange ──
# The collector binds its own exclusive, auto-deleting queue; it never declares the exchange.
#NW_RABBITMQ_URL=amqp://guest:guest@localhost:5672
#NW_RABBITMQ_QUEUE=nexuswatch.collector
# The same key NexusInfra and FinVault use; needed when their payloads are encrypted
#FINVAULT_MESSAGE_KEY=

# With the bus on, top-ups, payments and billing events are recorded too (ids and amounts only).
# Match NexusInfra's Billing Bridge settings (TOPUP_TIMEOUT_MS, LOW_CREDIT_HOURS):
#NW_TOPUP_TIMEOUT_MS=1800000
#NW_LOW_CREDIT_HOURS=24

# ── Docker Engine of this host (read-only use) ──────────────────────────
# Containers, CPU / memory per container (top consumers), memory, disk IO and network totals.
# Mount it read-only and give the collector the socket's group (compose: group_add: [<gid>]).
#NW_DOCKER_SOCKET=/var/run/docker.sock
NW_DOCKER_INTERVAL_MS=15000

# ── SLOs ───────────────────────────────────────────────────────────────
# Availability objective per monitored service, over 30 days
NW_SLO_TARGET=99.5

# ── Alert rules ────────────────────────────────────────────────────────
# How often the rules are evaluated against the stored measurements
NW_RULES_INTERVAL_MS=15000

# ── Notifications ──────────────────────────────────────────────────────
# A channel is off until its variable(s) are set. These are secrets: they never leave the collector,
# Settings only shows them masked. Which severity goes where is set on the Settings page.
#NW_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
# Telegram: the bot's token from @BotFather and the chat, group or channel id it may write to
#NW_TELEGRAM_BOT_TOKEN=123456:ABC-DEF
#NW_TELEGRAM_CHAT_ID=-1001234567890
# ntfy: server plus topic; the token only for a protected topic
#NW_NTFY_URL=https://ntfy.sh/<your-topic>
#NW_NTFY_TOKEN=
# Email: all three together
#NW_SMTP_URL=smtp://user:password@mail.example.org:587
#NW_EMAIL_FROM=nexuswatch@example.org
#NW_EMAIL_TO=you@example.org
# Address of this dashboard, linked from each notification
#NW_PUBLIC_URL=https://watch.home.example
# How often open and closed incidents are checked for notifications still to send
NW_NOTIFY_INTERVAL_MS=10000
NW_NOTIFY_TIMEOUT_MS=10000

# ── Retention ──────────────────────────────────────────────────────────
# How often old rows are pruned (retention per kind is set on the Settings page)
NW_PRUNE_INTERVAL_MS=3600000
