# Rendered by the nginx image's envsubst step: ${NW_API_UPSTREAM} is the collector.
server {
  listen 80;
  root /usr/share/nginx/html;

  location /api/ {
    proxy_pass ${NW_API_UPSTREAM};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # So the collector marks the session cookie Secure when this is served over https.
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
  }

  # Hashed assets never change; the app shell always revalidates.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # Client-side routes (/logs, /services/:id, …) all load the app.
  location / {
    try_files $uri /index.html;
  }
}
