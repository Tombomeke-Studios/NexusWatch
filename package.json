{
  "name": "nexuswatch",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "workspaces": [
    "dashboard",
    "collector"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:mocks": "npm --workspace dashboard run dev",
    "dev:collector": "npm --workspace collector run dev",
    "start:collector": "npm --workspace collector run start",
    "build": "npm --workspace dashboard run build && npm --workspace collector run build",
    "lint": "eslint .",
    "test": "npm --workspace dashboard run test && npm --workspace collector run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.1"
  }
}
